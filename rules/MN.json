      "checksum": {
        "status": "not_established"
      },
      "notes_zh": "蒙古 12 位民事登记号作个人税号，候选剖面。西里尔字母 2 字母 + 8 位的登记号不同，不在 ASCII 剖面内。",
      "semantic_checks": [],
      "normalization": [],
      "source_ids": [
