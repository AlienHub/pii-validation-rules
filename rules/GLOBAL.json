  "rules": [
    {
      "id": "GLOBAL.payment_pan_current",
      "pii_type": "payment_card",
      "status": "syntax_supported",
      "regex_pcre2": "\\A(?:[0-9]{10,19})\\z",
      "python_fullmatch_body": "[0-9]{10,19}",
      "checksum": {
        "status": "algorithm_available",
        "algorithm": "luhn",
        "evidence": "standard_algorithm",
        "policy": "enabled"
      },
      "notes_zh": "ISO/IEC 7812 现行：8 位 IIN，PAN 10-19 位。Luhn 仅是算术一致性，不是品牌识别、有效期、CVV、余额、授权或银行账号验证。测试仅使用处理商公开测试 PAN。",
      "semantic_checks": [],
      "normalization": [],
      "source_ids": [
        "iso.pan",
        "stripe.tests"
      ],
      "source_urls": [
        "https://www.iso.org/news/2016/11/Ref2146.html",
        "https://docs.stripe.com/testing"
      ],
      "accessed_on": "2026-11-13",
      "examples": [
        {
          "input": "4242424242424242",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture",
          "expected_checksum_arithmetic": true
        }
      ],
      "negative_syntax_examples": [
        {
          "input": "",
          "expected_syntax": false,
          "reason": "empty"
        },
        {
          "input": "!4242424242424242",
          "expected_syntax": false,
          "reason": "invalid_character"
        },
        {
          "input": "4242424242424242\n",
          "expected_syntax": false,
          "reason": "trailing_newline"
        },
        {
          "input": "\n4242424242424242",
          "expected_syntax": false,
          "reason": "leading_newline"
        },
        {
          "input": "4242424242424242!",
          "expected_syntax": false,
          "reason": "invalid_suffix"
        },
        {
          "input": "4２42424242424242",
          "expected_syntax": false,
          "reason": "non_ascii_digit"
        }
      ],
      "sample_notice_zh": "仅合成或官方说明性样本，可能与已发放号码偶然相同；不保证保留，绝不可用于身份、鉴权或支付操作。"
