    {
      "id": "GLOBAL.icao_mrz_field",
      "pii_type": "passport_mrz_field",
      "status": "syntax_supported",
      "regex_pcre2": "\\A(?:[A-Z0-9<]{1,44})\\z",
      "python_fullmatch_body": "[A-Z0-9<]{1,44}",
      "checksum": {
        "status": "not_applicable"
      },
      "notes_zh": "ICAO Doc 9303 MRZ 字段字符集 A-Z/0-9/<，最长 44。检查位是另一字段，使用 icao9303 模块按文档布局切片计算；本规则不是完整 MRZ 解析器，也不是国内护照号格式。",
      "semantic_checks": [],
      "normalization": [
        {
          "transform": "ascii_uppercase",
