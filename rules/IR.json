{
  "schema_version": "pii-rules-1",
  "version": "2026.11.13",
  "jurisdiction": "IR",
  "name_zh": "伊朗",
  "scope_group": "middle_east",
  "calling_code": "98",
  "regex_engine": "PCRE2",
  "anchor_policy": "\\A(?:body)\\z",
  "validation_scope_zh": "仅格式/校验码一致性，绝不是发证真实性。",
  "rules": [
    {
      "id": "IR.national_code",
      "pii_type": "national_id",
      "status": "candidate_profile",
      "regex_pcre2": "\\A(?:[0-9]{10})\\z",
      "python_fullmatch_body": "[0-9]{10}",
      "checksum": {
        "status": "algorithm_available",
        "algorithm": "ir_national_mod11",
        "evidence": "reconstructed",
        "policy": "opt_in_secondary"
      },
      "notes_zh": "伊朗 10 位国民号（کد ملی）。MOD 11 算法为二级来源可选算法；11 位法人号、外国人号分开。全同数字拒绝是反占位策略，不是校验定理。",
      "semantic_checks": [
        "repeated_digits_placeholder_policy"
      ],
      "normalization": [],
      "source_ids": [
        "ir.checksum"
      ],
      "source_urls": [
        "https://blog.u-id.net/national-code-validation-algorithm/"
      ],
      "accessed_on": "2026-11-13",
      "examples": [
        {
          "input": "0012345679",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture",
          "expected_checksum_arithmetic": true
        }
      ],
      "negative_syntax_examples": [
        {
          "input": "",
          "expected_syntax": false,
          "reason": "empty"
        },
        {
          "input": "!0012345679",
          "expected_syntax": false,
          "reason": "invalid_character"
        },
        {
          "input": "0012345679\n",
          "expected_syntax": false,
          "reason": "trailing_newline"
        },
        {
          "input": "\n0012345679",
          "expected_syntax": false,
          "reason": "leading_newline"
        },
        {
          "input": "0012345679!",
          "expected_syntax": false,
          "reason": "invalid_suffix"
        },
        {
          "input": "001234567",
          "expected_syntax": false,
          "reason": "too_short_or_missing_field"
        },
        {
          "input": "00123456790",
          "expected_syntax": false,
          "reason": "too_long"
        },
        {
          "input": "０012345679",
          "expected_syntax": false,
          "reason": "non_ascii_digit"
        }
      ],
      "sample_notice_zh": "仅合成或官方说明性样本，可能与已发放号码偶然相同；不保证保留，绝不可用于身份、鉴权或支付操作。"
    },
    {
      "id": "IR.phone_country_envelope",
      "pii_type": "phone",
      "status": "country_code_envelope_only",
      "regex_pcre2": "\\A(?:\\+98[0-9]{1,13})\\z",
      "python_fullmatch_body": "\\+98[0-9]{1,13}",
      "checksum": {
        "status": "not_applicable"
      },
      "notes_zh": "仅国家区号 + E.164 最多 15 位数字的外壳，不是国家电话号码验证器：NSN 长度、号段分配、移动/固话/服务类型均未验证。不得显示为“有效手机号”。",
      "semantic_checks": [],
      "normalization": [],
      "source_ids": [
        "itu.nnp",
        "itu.e164"
      ],
      "source_urls": [
        "https://www.itu.int/oth/t0202/en",
        "https://www.itu.int/rec/T-REC-E.164"
      ],
      "accessed_on": "2026-11-13",
      "examples": [
        {
          "input": "+981",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture"
        },
        {
          "input": "+981111111111111",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture"
        }
      ],
      "negative_syntax_examples": [
        {
          "input": "",
          "expected_syntax": false,
          "reason": "empty"
        },
        {
          "input": "!+981",
          "expected_syntax": false,
          "reason": "invalid_character"
        },
        {
          "input": "+981\n",
          "expected_syntax": false,
          "reason": "trailing_newline"
        },
        {
          "input": "\n+981",
          "expected_syntax": false,
          "reason": "leading_newline"
        },
        {
          "input": "+981!",
          "expected_syntax": false,
          "reason": "invalid_suffix"
        },
        {
          "input": "+98",
          "expected_syntax": false,
          "reason": "too_short_or_missing_field"
        },
        {
          "input": "+98１",
          "expected_syntax": false,
          "reason": "non_ascii_digit"
        }
      ],
      "sample_notice_zh": "仅合成或官方说明性样本，可能与已发放号码偶然相同；不保证保留，绝不可用于身份、鉴权或支付操作。"
    }
  ]
}