    {
      "id": "AE.emirates_id",
      "pii_type": "resident_id",
      "status": "syntax_supported",
      "regex_pcre2": "\\A(?:[0-9]{15})\\z",
      "python_fullmatch_body": "[0-9]{15}",
      "checksum": {
        "status": "not_established"
      },
      "notes_zh": "Emirates ID 15 位、永久唯一；官方说明号码内年份未必等于出生年。784 前缀与 Luhn 为流传说法，本次没有发证机关公开公式，不作为默认算法。",
      "semantic_checks": [],
      "normalization": [],
      "source_ids": [
        "ae.id",
        "ae.notbirth"
      ],
      "source_urls": [
        "https://icp.gov.ae/en/id-card-benefits/id-card-features/",
        "https://icp.gov.ae/en/media-center/emirates-id-the-id-number-may-not-be-amended-and-does-not-match-the-year-of-birth-necessarily/"
      ],
      "accessed_on": "2026-11-13",
      "examples": [
        {
          "input": "784199000000001",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture"
        }
      ],
      "negative_syntax_examples": [
        {
          "input": "",
          "expected_syntax": false,
          "reason": "empty"
        },
        {
          "input": "!784199000000001",
          "expected_syntax": false,
          "reason": "invalid_character"
        },
        {
          "input": "784199000000001\n",
          "expected_syntax": false,
          "reason": "trailing_newline"
        },
        {
          "input": "\n784199000000001",
          "expected_syntax": false,
          "reason": "leading_newline"
        },
        {
          "input": "784199000000001!",
          "expected_syntax": false,
          "reason": "invalid_suffix"
        },
        {
          "input": "78419900000000",
          "expected_syntax": false,
          "reason": "too_short_or_missing_field"
        },
        {
          "input": "7841990000000010",
          "expected_syntax": false,
          "reason": "too_long"
        },
        {
          "input": "784199０00000001",
