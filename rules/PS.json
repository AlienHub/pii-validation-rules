{
  "schema_version": "pii-rules-1",
  "version": "2026.11.13",
  "jurisdiction": "PS",
  "name_zh": "巴勒斯坦",
  "scope_group": "middle_east",
  "calling_code": "970",
  "regex_engine": "PCRE2",
  "anchor_policy": "\\A(?:body)\\z",
  "validation_scope_zh": "仅格式/校验码一致性，绝不是发证真实性。",
  "rules": [
    {
      "id": "PS.iban",
      "pii_type": "iban",
      "status": "syntax_supported",
      "regex_pcre2": "\\A(?:PS[0-9]{2}[A-Z]{4}[A-Z0-9]{21})\\z",
      "python_fullmatch_body": "PS[0-9]{2}[A-Z]{4}[A-Z0-9]{21}",
      "length": 29,
      "iban_bban_notation": "4!a21!c",
      "checksum": {
        "status": "algorithm_available",
        "algorithm": "iban_mod97",
        "evidence": "official",
        "policy": "enabled"
      },
      "notes_zh": "SWIFT IBAN Registry（Release 103，2026-09）结构；n=数字、a=大写字母、c=字母数字。MOD 97-10 只证明算术一致性，不证明银行/账户存在。合成样本使用非真实银行代码。",
      "semantic_checks": [],
      "normalization": [
        {
          "transform": "strip_print_format_spaces",
          "layout": "groups of 4 separated by single spaces"
        },
        {
          "transform": "ascii_uppercase",
          "requires_option": "ascii_uppercase"
        }
      ],
      "source_ids": [
        "swift.103",
        "swift.copy"
      ],
      "source_urls": [
        "https://www.swift.com/sites/default/files/files/iban-registry_4.pdf",
        "https://www.cby-ye.com/files/67335413e8237.pdf"
      ],
      "accessed_on": "2026-11-13",
      "examples": [
        {
          "input": "PS30ZZZZZZZZZZZZZZZZZZZZZZZZZ",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture",
          "expected_checksum_arithmetic": true
        }
      ],
      "negative_syntax_examples": [
        {
          "input": "",
          "expected_syntax": false,
          "reason": "empty"
        },
        {
          "input": "!PS30ZZZZZZZZZZZZZZZZZZZZZZZZZ",
          "expected_syntax": false,
          "reason": "invalid_character"
        },
        {
          "input": "PS30ZZZZZZZZZZZZZZZZZZZZZZZZZ\n",
          "expected_syntax": false,
          "reason": "trailing_newline"
        },
        {
          "input": "\nPS30ZZZZZZZZZZZZZZZZZZZZZZZZZ",
          "expected_syntax": false,
          "reason": "leading_newline"
        },
        {
          "input": "PS30ZZZZZZZZZZZZZZZZZZZZZZZZZ!",
          "expected_syntax": false,
          "reason": "invalid_suffix"
        },
        {
          "input": "PS30ZZZZZZZZZZZZZZZZZZZZZZZZ",
          "expected_syntax": false,
          "reason": "too_short_or_missing_field"
        },
        {
          "input": "PS30ZZZZZZZZZZZZZZZZZZZZZZZZZ0",
          "expected_syntax": false,
          "reason": "too_long"
        },
        {
          "input": "PS3０ZZZZZZZZZZZZZZZZZZZZZZZZZ",
          "expected_syntax": false,
          "reason": "non_ascii_digit"
        }
      ],
      "sample_notice_zh": "仅合成或官方说明性样本，可能与已发放号码偶然相同；不保证保留，绝不可用于身份、鉴权或支付操作。"
    },
    {
      "id": "PS.phone_country_envelope",
