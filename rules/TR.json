      "id": "TR.tckn",
      "pii_type": "national_id",
      "status": "syntax_supported",
      "regex_pcre2": "\\A(?:[1-9][0-9]{10})\\z",
      "python_fullmatch_body": "[1-9][0-9]{10}",
      "checksum": {
        "status": "algorithm_available",
        "algorithm": "tr_tckn",
        "evidence": "reconstructed",
        "policy": "opt_in_secondary"
      },
      "notes_zh": "T.C. Kimlik No 11 位，首位非 0。两段校验公式（d10、d11）为二级资料重建，政府页面确认结构而非公式；默认不启用。",
      "semantic_checks": [],
      "normalization": [],
      "source_ids": [
        "tr.id",
        "oecd.TR",
        "tr.checksum"
      ],
