        "policy": "opt_in_secondary_m_series_experimental"
      },
      "notes_zh": "ICA：NRIC 为 S/T + 7 位数字 + 字母。字母校验表（权重 2,7,6,5,4,3,2，S/T 对照表）为公开重建，不是本次取得的 ICA 官方算法，默认不启用。",
      "semantic_checks": [],
      "normalization": [
        {
          "transform": "ascii_uppercase",
          "requires_option": "ascii_uppercase"
        }
