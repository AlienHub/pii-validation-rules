        "status": "none_per_source"
      },
      "notes_zh": "澳门商业个人纳税人编号 0 + 7 位数字。OECD 明确该税号没有检查位。",
      "semantic_checks": [],
      "normalization": [],
      "source_ids": [
        "oecd.MO"
      ],
