  "rules": [
    {
      "id": "TH.citizen_id",
      "pii_type": "national_id",
      "status": "syntax_supported",
      "regex_pcre2": "\\A(?:[1-8][0-9]{12})\\z",
      "python_fullmatch_body": "[1-8][0-9]{12}",
      "checksum": {
        "status": "algorithm_available",
        "algorithm": "th_mod11",
        "evidence": "official_structure_secondary_formula",
        "policy": "opt_in_secondary"
      },
      "notes_zh": "DOPA 13 位公民身份号码，首位类别 1-8，末位检查位。0 类无国籍登记号属另一记录类型，不在本规则。校验公式来自二级技术资料，官方 OECD 材料仅确认存在检查位且 RD 税号用同一方法。",
      "semantic_checks": [],
      "normalization": [],
      "source_ids": [
        "th.structure",
        "th.checksum"
      ],
      "source_urls": [
        "https://datastandard.m-society.go.th/datatable/index/1",
        "https://charin-nawaritloha.github.io/excel-vba-notes/20180111_check_sum_id.html"
      ],
      "accessed_on": "2026-11-13",
      "examples": [
        {
          "input": "1234567890121",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture",
          "expected_checksum_arithmetic": true
        }
      ],
      "negative_syntax_examples": [
        {
          "input": "",
          "expected_syntax": false,
          "reason": "empty"
        },
        {
          "input": "!1234567890121",
          "expected_syntax": false,
          "reason": "invalid_character"
        },
        {
          "input": "1234567890121\n",
          "expected_syntax": false,
          "reason": "trailing_newline"
        },
        {
          "input": "\n1234567890121",
          "expected_syntax": false,
          "reason": "leading_newline"
        },
        {
          "input": "1234567890121!",
          "expected_syntax": false,
          "reason": "invalid_suffix"
        },
        {
          "input": "123456789012",
          "expected_syntax": false,
          "reason": "too_short_or_missing_field"
        },
        {
          "input": "12345678901210",
          "expected_syntax": false,
          "reason": "too_long"
        },
        {
          "input": "123456789０121",
          "expected_syntax": false,
          "reason": "non_ascii_digit"
        }
      ],
      "sample_notice_zh": "仅合成或官方说明性样本，可能与已发放号码偶然相同；不保证保留，绝不可用于身份、鉴权或支付操作。"
    },
    {
