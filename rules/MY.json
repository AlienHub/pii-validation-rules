{
  "schema_version": "pii-rules-1",
  "version": "2026.11.13",
  "jurisdiction": "MY",
  "name_zh": "马来西亚",
  "scope_group": "core",
  "calling_code": "60",
  "regex_engine": "PCRE2",
  "anchor_policy": "\\A(?:body)\\z",
  "validation_scope_zh": "仅格式/校验码一致性，绝不是发证真实性。",
  "rules": [
    {
      "id": "MY.nric",
      "pii_type": "national_id",
      "status": "syntax_supported",
      "regex_pcre2": "\\A(?:[0-9]{12})\\z",
      "python_fullmatch_body": "[0-9]{12}",
      "checksum": {
        "status": "not_established"
      },
      "notes_zh": "MyKad NRIC 12 位（展示格式 YYMMDD-PB-####）。出生日期/世纪、出生地码需要独立语义与历史码表；未证实统一校验码；末位奇偶是性别属性不是校验位。",
      "semantic_checks": [
        "yymmdd_birth_date_pos1_6",
        "century_ambiguous",
        "birthplace_code_not_verified"
      ],
      "normalization": [
        {
          "transform": "strip_fixed_separators",
          "layout": "NNNNNN-NN-NNNN",
          "separator": "-"
        }
      ],
      "source_ids": [
        "oecd.MY"
      ],
      "source_urls": [
        "https://www.oecd.org/content/dam/oecd/en/topics/policy-issue-focus/aeoi/malaysia-tin.pdf"
      ],
      "accessed_on": "2026-11-13",
      "examples": [
        {
          "input": "900101010001",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture"
        }
      ],
      "negative_syntax_examples": [
        {
          "input": "",
          "expected_syntax": false,
          "reason": "empty"
        },
        {
          "input": "!900101010001",
          "expected_syntax": false,
          "reason": "invalid_character"
        },
        {
          "input": "900101010001\n",
          "expected_syntax": false,
          "reason": "trailing_newline"
        },
        {
          "input": "\n900101010001",
          "expected_syntax": false,
          "reason": "leading_newline"
        },
        {
          "input": "900101010001!",
          "expected_syntax": false,
          "reason": "invalid_suffix"
        },
        {
          "input": "90010101000",
          "expected_syntax": false,
          "reason": "too_short_or_missing_field"
        },
        {
          "input": "9001010100010",
          "expected_syntax": false,
          "reason": "too_long"
        },
        {
          "input": "9０0101010001",
          "expected_syntax": false,
          "reason": "non_ascii_digit"
        }
      ],
      "sample_notice_zh": "仅合成或官方说明性样本，可能与已发放号码偶然相同；不保证保留，绝不可用于身份、鉴权或支付操作。"
    },
    {
      "id": "MY.tin_individual",
      "pii_type": "tax_id",
      "status": "candidate_profile",
      "regex_pcre2": "\\A(?:IG[0-9]{9,11})\\z",
      "python_fullmatch_body": "IG[0-9]{9,11}",
      "checksum": {
        "status": "not_established"
      },
      "notes_zh": "LHDN 2023 年 TIN 说明给出 IG+9/10/11 位数字的示例。9 位下限是示例推断的候选剖面，不是官方对所有遗留短号的否定。",
      "semantic_checks": [],
      "normalization": [
