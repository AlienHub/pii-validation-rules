  "rules": [
    {
      "id": "HK.hkid",
      "pii_type": "national_id",
      "status": "syntax_supported",
      "regex_pcre2": "\\A(?:[A-Z]{1,2}[0-9]{6}[0-9A])\\z",
      "python_fullmatch_body": "[A-Z]{1,2}[0-9]{6}[0-9A]",
      "checksum": {
        "status": "algorithm_available",
        "algorithm": "hkid_mod11",
        "evidence": "official_structure_secondary_algorithm",
        "policy": "opt_in_secondary"
      },
      "notes_zh": "HKID：1-2 字母 + 6 位数字 + 检查字符 0-9/A（政府 DPO 公共架构与 OECD）。单字母补值 36 的 MOD 11 公式来自二级资料，默认可选。DPO 示例 A123456(A) 仅示意，不是校验正例。括号仅展示用。",
      "semantic_checks": [],
      "normalization": [
        {
          "transform": "strip_trailing_parenthesised_check",
          "layout": "BODY(C)"
        },
        {
          "transform": "ascii_uppercase",
          "requires_option": "ascii_uppercase"
        }
      ],
      "source_ids": [
        "hk.format",
        "oecd.HK",
        "hk.checksum"
      ],
      "source_urls": [
        "https://www.digitalpolicy.gov.hk/en/our_work/data_governance/policies_standards/interoperability_framework/common_schemas/hkid_number/index.html",
        "https://www.oecd.org/content/dam/oecd/en/topics/policy-issue-focus/aeoi/hong-kong-tin.pdf",
        "https://fongbin.com/hkid-checker/"
      ],
      "accessed_on": "2026-11-13",
      "examples": [
        {
          "input": "A1234563",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture",
          "expected_checksum_arithmetic": true
        },
        {
          "input": "AB1234569",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture",
          "expected_checksum_arithmetic": true
        }
      ],
      "negative_syntax_examples": [
        {
          "input": "",
          "expected_syntax": false,
          "reason": "empty"
        },
        {
          "input": "!A1234563",
          "expected_syntax": false,
          "reason": "invalid_character"
        },
        {
          "input": "A1234563\n",
          "expected_syntax": false,
          "reason": "trailing_newline"
        },
        {
          "input": "\nA1234563",
          "expected_syntax": false,
          "reason": "leading_newline"
        },
        {
          "input": "A1234563!",
          "expected_syntax": false,
          "reason": "invalid_suffix"
        },
        {
          "input": "A123456",
          "expected_syntax": false,
          "reason": "too_short_or_missing_field"
        },
        {
          "input": "A12345630",
          "expected_syntax": false,
          "reason": "too_long"
        },
        {
          "input": "A１234563",
          "expected_syntax": false,
          "reason": "non_ascii_digit"
        }
      ],
      "sample_notice_zh": "仅合成或官方说明性样本，可能与已发放号码偶然相同；不保证保留，绝不可用于身份、鉴权或支付操作。"
    },
