  "rules": [
    {
      "id": "KR.rrn",
      "pii_type": "national_id",
      "status": "syntax_supported",
      "regex_pcre2": "\\A(?:[0-9]{6}[0-9][0-9]{6})\\z",
      "python_fullmatch_body": "[0-9]{6}[0-9][0-9]{6}",
      "checksum": {
        "status": "algorithm_available",
        "algorithm": "kr_rrn_legacy",
        "evidence": "legacy_secondary_algorithm",
        "policy": "explicit_legacy_regime"
      },
      "notes_zh": "住民登录番号 13 位外壳。2020 年 10 月起新发/变更号码在性别世纪位后 6 位随机，旧权重校验不能用于拒绝现代号码，不能由出生日期推断发证年代。旧算法仅在显式 legacy_pre_2020_10 模式运行。",
      "semantic_checks": [
        "yymmdd_birth_date_pos1_6_with_century_digit_pos7",
        "not_after_reference_date"
      ],
      "normalization": [],
      "source_ids": [
        "oecd.KR",
        "kr.regime"
      ],
      "source_urls": [
        "https://www.oecd.org/content/dam/oecd/en/topics/policy-issue-focus/aeoi/korea-tin.pdf",
        "https://www.mois.go.kr/frt/bbs/type010/commonSelectBoardArticle.do?bbsId=BBSMSTR_000000000008&nttId=74731"
      ],
      "accessed_on": "2026-11-13",
      "examples": [
        {
          "input": "9001011234568",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture_legacy_formula_consistent",
          "expected_checksum_arithmetic": true
        },
        {
          "input": "9001011234560",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture_legacy_formula_inconsistent",
          "expected_checksum_arithmetic": false
        }
      ],
      "negative_syntax_examples": [
        {
          "input": "",
          "expected_syntax": false,
          "reason": "empty"
        },
        {
          "input": "!9001011234568",
          "expected_syntax": false,
          "reason": "invalid_character"
        },
        {
          "input": "9001011234568\n",
          "expected_syntax": false,
          "reason": "trailing_newline"
        },
        {
          "input": "\n9001011234568",
          "expected_syntax": false,
          "reason": "leading_newline"
        },
        {
          "input": "9001011234568!",
          "expected_syntax": false,
          "reason": "invalid_suffix"
        },
        {
          "input": "900101123456",
          "expected_syntax": false,
          "reason": "too_short_or_missing_field"
        },
        {
          "input": "90010112345680",
          "expected_syntax": false,
          "reason": "too_long"
        },
        {
          "input": "9０01011234568",
          "expected_syntax": false,
          "reason": "non_ascii_digit"
        }
      ],
      "sample_notice_zh": "仅合成或官方说明性样本，可能与已发放号码偶然相同；不保证保留，绝不可用于身份、鉴权或支付操作。"
    },
