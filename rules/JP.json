  "jurisdiction": "JP",
  "name_zh": "日本",
  "scope_group": "additional_asia",
  "calling_code": "81",
  "regex_engine": "PCRE2",
  "anchor_policy": "\\A(?:body)\\z",
  "validation_scope_zh": "仅格式/校验码一致性，绝不是发证真实性。",
  "rules": [
    {
      "id": "JP.my_number",
      "pii_type": "national_id",
      "status": "syntax_supported",
      "regex_pcre2": "\\A(?:[0-9]{12})\\z",
      "python_fullmatch_body": "[0-9]{12}",
      "checksum": {
        "status": "algorithm_available",
        "algorithm": "jp_mynumber",
        "evidence": "official",
        "policy": "enabled"
      },
      "notes_zh": "个人番号 12 位，末位检查位。公式来自总务省令第 5 条（Pn、Qn 定义，余数 ≤1 时为 0），官方。绝不可套用到 13 位法人番号。",
      "semantic_checks": [],
      "normalization": [],
      "source_ids": [
        "jp.checksum",
        "oecd.JP"
      ],
      "source_urls": [
        "https://laws.e-gov.go.jp/law/426M60000008085",
        "https://www.oecd.org/content/dam/oecd/en/topics/policy-issue-focus/aeoi/japan-tin.pdf"
      ],
      "accessed_on": "2026-11-13",
      "examples": [
        {
          "input": "123456789018",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture",
          "expected_checksum_arithmetic": true
        }
      ],
      "negative_syntax_examples": [
        {
          "input": "",
          "expected_syntax": false,
          "reason": "empty"
        },
        {
          "input": "!123456789018",
          "expected_syntax": false,
          "reason": "invalid_character"
        },
        {
          "input": "123456789018\n",
          "expected_syntax": false,
          "reason": "trailing_newline"
        },
        {
          "input": "\n123456789018",
          "expected_syntax": false,
          "reason": "leading_newline"
        },
        {
          "input": "123456789018!",
          "expected_syntax": false,
          "reason": "invalid_suffix"
        },
        {
          "input": "12345678901",
          "expected_syntax": false,
          "reason": "too_short_or_missing_field"
        },
        {
          "input": "1234567890180",
          "expected_syntax": false,
          "reason": "too_long"
        },
        {
          "input": "123456789０18",
          "expected_syntax": false,
          "reason": "non_ascii_digit"
        }
      ],
      "sample_notice_zh": "仅合成或官方说明性样本，可能与已发放号码偶然相同；不保证保留，绝不可用于身份、鉴权或支付操作。"
    },
    {
