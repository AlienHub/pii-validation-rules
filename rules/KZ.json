  "jurisdiction": "KZ",
  "name_zh": "哈萨克斯坦",
  "scope_group": "additional_asia",
  "calling_code": "7",
  "regex_engine": "PCRE2",
  "anchor_policy": "\\A(?:body)\\z",
  "validation_scope_zh": "仅格式/校验码一致性，绝不是发证真实性。",
  "rules": [
    {
      "id": "KZ.iin",
      "pii_type": "national_id",
      "status": "syntax_supported",
      "regex_pcre2": "\\A(?:[0-9]{12})\\z",
      "python_fullmatch_body": "[0-9]{12}",
      "checksum": {
        "status": "algorithm_available",
        "algorithm": "kz_iin",
        "evidence": "official",
        "policy": "enabled"
      },
      "notes_zh": "哈萨克斯坦 IIN 12 位，两轮 MOD 11 校验（2023 年部长令）。不强制解析出生日期/性别；第二轮仍为 10 时不存在合法检查位。",
      "semantic_checks": [],
      "normalization": [],
      "source_ids": [
        "oecd.KZ",
        "kz.checksum"
      ],
      "source_urls": [
        "https://www.oecd.org/content/dam/oecd/en/topics/policy-issue-focus/aeoi/kazakhstan-tin.pdf",
        "https://adilet.zan.kz/rus/docs/V2300032942"
      ],
      "accessed_on": "2026-11-13",
      "examples": [
        {
          "input": "123456789013",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture",
          "expected_checksum_arithmetic": true
        }
      ],
      "negative_syntax_examples": [
        {
          "input": "",
          "expected_syntax": false,
          "reason": "empty"
        },
        {
          "input": "!123456789013",
          "expected_syntax": false,
          "reason": "invalid_character"
        },
        {
          "input": "123456789013\n",
          "expected_syntax": false,
          "reason": "trailing_newline"
        },
        {
          "input": "\n123456789013",
          "expected_syntax": false,
          "reason": "leading_newline"
        },
        {
          "input": "123456789013!",
          "expected_syntax": false,
          "reason": "invalid_suffix"
        },
        {
          "input": "12345678901",
          "expected_syntax": false,
          "reason": "too_short_or_missing_field"
        },
        {
          "input": "1234567890130",
          "expected_syntax": false,
          "reason": "too_long"
        },
        {
          "input": "123456789０13",
          "expected_syntax": false,
          "reason": "non_ascii_digit"
        }
      ],
      "sample_notice_zh": "仅合成或官方说明性样本，可能与已发放号码偶然相同；不保证保留，绝不可用于身份、鉴权或支付操作。"
    },
