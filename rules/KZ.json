      "regex_pcre2": "\\A(?:KZ[0-9]{2}[0-9]{3}[A-Z0-9]{13})\\z",
      "python_fullmatch_body": "KZ[0-9]{2}[0-9]{3}[A-Z0-9]{13}",
      "length": 20,
      "iban_bban_notation": "3!n13!c",
      "checksum": {
        "status": "algorithm_available",
        "algorithm": "iban_mod97",
        "evidence": "official",
        "policy": "enabled"
      },
      "notes_zh": "SWIFT IBAN Registry（Release 103，2026-09）结构；n=数字、a=大写字母、c=字母数字。MOD 97-10 只证明算术一致性，不证明银行/账户存在。合成样本使用非真实银行代码。",
      "semantic_checks": [],
      "normalization": [
