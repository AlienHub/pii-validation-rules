      "id": "TW.citizen_id",
      "pii_type": "national_id",
      "status": "syntax_supported",
      "regex_pcre2": "\\A(?:[A-Z][12][0-9]{8})\\z",
      "python_fullmatch_body": "[A-Z][12][0-9]{8}",
      "checksum": {
        "status": "algorithm_available",
        "algorithm": "tw_citizen_new_ui",
        "evidence": "official_structure_secondary_algorithm",
        "policy": "opt_in_secondary"
      },
      "notes_zh": "国民身分证统一编号：1 字母 + [12] + 8 位数字。字母换算与 MOD 10 算术来自协会/技术资料，默认可选。",
      "semantic_checks": [],
      "normalization": [
        {
          "transform": "ascii_uppercase",
          "requires_option": "ascii_uppercase"
        }
      ],
      "source_ids": [
        "tw.format",
        "tw.checksum",
        "tw.id.checksum"
      ],
      "source_urls": [
        "https://www.immigration.gov.tw/5385/12162/238449/382804/",
