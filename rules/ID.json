    {
      "id": "ID.nik",
      "pii_type": "national_id",
      "status": "syntax_supported",
      "regex_pcre2": "\\A(?:[0-9]{16})\\z",
      "python_fullmatch_body": "[0-9]{16}",
      "checksum": {
        "status": "not_established"
      },
      "notes_zh": "NIK 16 位：6 位地区码 + DDMMYY（女性日 +40）+ 4 位序列。本次未获证实的公开校验码，末位不是校验位。YY 无法唯一确定世纪。",
      "semantic_checks": [
        "ddmmyy_birth_date_pos7_12_female_day_plus_40",
        "century_ambiguous",
        "region_code_not_verified"
      ],
      "normalization": [],
      "source_ids": [
        "id.nik"
      ],
      "source_urls": [
