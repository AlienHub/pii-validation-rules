  "rules": [
    {
      "id": "BD.etin",
      "pii_type": "tax_id",
      "status": "candidate_profile",
      "regex_pcre2": "\\A(?:[0-9]{12})\\z",
      "python_fullmatch_body": "[0-9]{12}",
      "checksum": {
        "status": "not_established"
      },
      "notes_zh": "孟加拉 12 位 e-TIN，候选剖面，需核看 NBR 原表。NID 10/13/17 位代际未获可靠完整官方规格，不收录。",
      "semantic_checks": [],
      "normalization": [],
      "source_ids": [
        "bd.tin"
      ],
      "source_urls": [
        "https://nbr.gov.bd/uploads/form/483.pdf"
      ],
      "accessed_on": "2026-11-13",
      "examples": [
        {
          "input": "123456789012",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture"
        }
      ],
      "negative_syntax_examples": [
        {
          "input": "",
          "expected_syntax": false,
          "reason": "empty"
        },
        {
          "input": "!123456789012",
          "expected_syntax": false,
          "reason": "invalid_character"
        },
        {
          "input": "123456789012\n",
          "expected_syntax": false,
          "reason": "trailing_newline"
        },
        {
          "input": "\n123456789012",
          "expected_syntax": false,
          "reason": "leading_newline"
        },
        {
          "input": "123456789012!",
          "expected_syntax": false,
          "reason": "invalid_suffix"
        },
        {
          "input": "12345678901",
          "expected_syntax": false,
          "reason": "too_short_or_missing_field"
        },
        {
          "input": "1234567890120",
          "expected_syntax": false,
          "reason": "too_long"
        },
        {
          "input": "123456789０12",
          "expected_syntax": false,
          "reason": "non_ascii_digit"
        }
      ],
      "sample_notice_zh": "仅合成或官方说明性样本，可能与已发放号码偶然相同；不保证保留，绝不可用于身份、鉴权或支付操作。"
    },
    {
