  "jurisdiction": "KH",
  "name_zh": "柬埔寨",
  "scope_group": "additional_asia",
  "calling_code": "855",
  "regex_engine": "PCRE2",
  "anchor_policy": "\\A(?:body)\\z",
  "validation_scope_zh": "仅格式/校验码一致性，绝不是发证真实性。",
  "rules": [
    {
      "id": "KH.phone_country_envelope",
      "pii_type": "phone",
      "status": "country_code_envelope_only",
      "regex_pcre2": "\\A(?:\\+855[0-9]{1,12})\\z",
      "python_fullmatch_body": "\\+855[0-9]{1,12}",
      "checksum": {
        "status": "not_applicable"
      },
      "notes_zh": "仅国家区号 + E.164 最多 15 位数字的外壳，不是国家电话号码验证器：NSN 长度、号段分配、移动/固话/服务类型均未验证。不得显示为“有效手机号”。",
      "semantic_checks": [],
      "normalization": [],
      "source_ids": [
        "itu.nnp",
        "itu.e164"
      ],
      "source_urls": [
        "https://www.itu.int/oth/t0202/en",
        "https://www.itu.int/rec/T-REC-E.164"
      ],
      "accessed_on": "2026-11-13",
      "examples": [
        {
          "input": "+8551",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture"
        },
        {
          "input": "+855111111111111",
          "expected_syntax": true,
          "provenance": "synthetic_research_fixture"
        }
      ],
      "negative_syntax_examples": [
