  "rules": [
    {
      "id": "VN.personal_id",
      "pii_type": "national_id",
      "status": "syntax_supported",
      "regex_pcre2": "\\A(?:[0-9]{12})\\z",
      "python_fullmatch_body": "[0-9]{12}",
      "checksum": {
        "status": "not_established"
      },
      "notes_zh": "越南 12 位个人识别号（公民身份证号）。2025-07-01 起在规定条件下替代个人税号，不代表所有法人或外国人税号改为 12 位。",
      "semantic_checks": [],
      "normalization": [],
      "source_ids": [
        "vn.id",
        "vn.taxchange"
      ],
